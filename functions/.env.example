# Ini CONTOH — salin ke `.env.local` bila mau menguji lewat emulator, atau (untuk deploy sungguhan)
# JANGAN taruh nilai asli di berkas .env manapun. Kunci asli disetel lewat perintah CLI di bawah, yang
# menyimpannya di Google Cloud Secret Manager (bukan di kode, bukan di repo):
#
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set MIDTRANS_SERVER_KEY
#   firebase functions:secrets:set MIDTRANS_CLIENT_KEY
#
# (Tiap perintah akan menanyakan nilainya secara interaktif — tidak tersimpan di riwayat shell/berkas.)

# Domain web Anda begitu sudah punya (boleh beberapa dipisah tanpa spasi bila perlu diperluas
# di claudeProxy.ts) — sementara pakai "*" dulu saat masih uji coba.
ALLOWED_ORIGIN=*

# "false" = sandbox Midtrans (uji coba, tanpa uang sungguhan). Ganti ke "true" setelah akun
# production Midtrans Anda disetujui.
MIDTRANS_PRODUCTION=false
