# Contoh — salin ke ".env.local" (sudah di-gitignore) lalu isi dengan nilai project Firebase Anda.
# Nilai-nilai ini AMAN untuk diketahui publik/ikut ter-bundle (bukan rahasia) — Firebase memang
# didesain begitu; keamanan sesungguhnya ada di Firestore Rules & Cloud Functions, bukan di sini.
# Ambil dari: Firebase Console → ⚙️ Project settings → General → "Your apps" → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# URL Cloud Function `claudeProxy` setelah di-deploy, mis.:
# https://claudeproxy-xxxxxxxxxx-uc.a.run.app
VITE_CLAUDE_PROXY_URL=
